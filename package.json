{
  "name": "@azsxdc12356/utils",
  "version": "1.0.5",
  "description": "TypeScript utility functions and React Hooks",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js"
    },
    "./mockMiddleWare": {
      "types": "./dist/node/mockMiddleWare.d.ts",
      "import": "./dist/node/mockMiddleWare.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "pushToNpm": "npm publish --access public --registry https://registry.npmjs.org"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "keywords": [
    "typescript",
    "utils",
    "hooks",
    "react",
    "promise",
    "timer"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/junjie-z666/utils.git"
  },
  "homepage": "https://github.com/junjie-z666/utils",
  "bugs": {
    "url": "https://github.com/junjie-z666/utils/issues"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.15",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.0.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.8.3",
    "react": "^19.2.6",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.59.4",
    "vitest": "^3.0.0"
  }
}
